NODE_ENV=development
PORT=3000
# Local run (npm run start:dev) talks to the compose Postgres on host port 5435.
DATABASE_URL=postgres://jarvis:jarvis@localhost:5435/jarvis
DB_LOGGING=false

FRONTEND_URL=http://localhost:5173

# Google Cloud Console -> OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# AES-256-GCM key for Google tokens: openssl rand -base64 32
# Changing it makes stored tokens unreadable.
TOKEN_ENC_KEY=
# Session JWT secret: openssl rand -base64 48
JWT_SECRET=
SESSION_TTL_DAYS=7

# Chat model API: anthropic (default) or openrouter.
LLM_PROVIDER=anthropic
# Needed for LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Needed for LLM_PROVIDER=openrouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
# Model id. Default: claude-opus-5-5 for anthropic, openrouter/free for openrouter.
# Free OpenRouter models end in ":free" and must support tool calling,
# e.g. google/gemma-4-31b-it:free
#LLM_MODEL=
OPENROUTER_API_KEY=

# Scheduled briefings (morning, evening, weekly). Each run costs model tokens.
SCHEDULER_ENABLED=true
